{
  "manifest_version": 3,
  "name": "Chat Conversation Exporter",
  "version": "1.4.1",
  "description": "Export chat conversations from various LLM platforms (Markdown, PDF, HTML, JSON)",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.googleapis.com/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://www.chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}